// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  password      String
  points        Int       @default(0)    // XP Total
  streak        Int       @default(0)    // Dias seguidos
  isPremium     Boolean   @default(false)
  avatarUrl     String?
  
  tasks         Task[]
  memberships   GroupMember[]
  activities    Activity[]
  focusSessions FocusSession[] // <--- ADICIONADO: Relacionamento com o Histórico
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model FocusSession {
  id        String   @id @default(uuid())
  duration  Int      // Tempo em minutos
  startTime DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   // Ex: "Medicina", "Dev"
  imageUrl    String?
  members     GroupMember[]
  
  createdAt   DateTime @default(now())
}

model GroupMember {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  group          Group    @relation(fields: [groupId], references: [id])
  groupId        String
  
  weeklyXp       Int      @default(0) 
  totalXpInGroup Int      @default(0)

  @@unique([userId, groupId])
}

model Task {
  id          String    @id @default(uuid())
  title       String
  duration    Int       // Tempo em minutos para o Pomodoro
  points      Int       @default(10) // XP ganho ao concluir
  completed   Boolean   @default(false)
  
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model Activity {
  id          String   @id @default(uuid())
  type        String   // "TASK_COMPLETED", "POMODORO", "BADGE"
  description String   // Ex: "Focou por 2h no Projeto"
  icon        String?  // Ex: "clock", "check-circle"
  
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  
  createdAt   DateTime @default(now())
}